{
  "manifest_version": 3,
  "name": "Momentum M3 - Focus & Tasks",
  "version": "1.0.0",
  "description": "Material Design 3 New Tab with a digital clock, dynamic greeting, focus timer, and ultra-minimalist to-do list.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "favicon",
    "storage",
    "topSites"
  ],
  "optional_permissions": [
    "notifications"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["audio/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
